# Server-only pooled Neon PostgreSQL connection string. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Neon Managed Better Auth — copy to .env.local for local development.
NEON_AUTH_BASE_URL=https://ep-mute-fire-b2h30n59.neonauth.c-6.eu-central-1.aws.neon.tech/neondb/auth
# Generate a unique secret with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
