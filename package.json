{
  "name": "path",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "yarn workspace @path/web dev",
    "dev:mobile": "yarn workspace @path/mobile start",
    "typecheck": "yarn workspaces foreach -A run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
